# MailTrace Environment Variables
#
# Copy this file to your PRIVATE per-user configuration:
#   Linux/macOS: ~/.config/mailtrace/.env
#   Windows:     %USERPROFILE%\.config\mailtrace\.env
#
# Do NOT copy it to the project folder. A project-local .env is ignored by
# default because a cloned/shared folder must never carry one person's keys.
# Use your own credentials only. Never commit or share this file.

# Have I Been Pwned API Key (paid subscription required)
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# BreachDirectory API Key (RapidAPI)
# https://rapidapi.com/breachdirectory/api/breachdirectory
BREACHDIRECTORY_API_KEY=

# emailrep.io - No API key required for basic usage (optional for higher limits)
# https://emailrep.io
EMAILREP_API_KEY=

# GitHub Personal Access Token (public_repo scope)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Brave Search API Key
# https://brave.com/search/api/
BRAVE_API_KEY=

# VirusTotal API Key
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Provider toggles. Providers that need a key are only run when the toggle is
# enabled AND the matching key/token above is set. HIBP, GitHub, emailrep.io and
# DNS are enabled by default; BreachDirectory, Brave Search and VirusTotal are
# opt-in. Both spellings are accepted:
# MAILTRACE_BREACHDIRECTORY_ENABLED and BREACHDIRECTORY_ENABLED.
# MAILTRACE_HIBP_ENABLED=true
# MAILTRACE_BREACHDIRECTORY_ENABLED=true
# MAILTRACE_EMAILREP_ENABLED=true
# MAILTRACE_GITHUB_ENABLED=true
# MAILTRACE_BRAVE_SEARCH_ENABLED=true
# MAILTRACE_VIRUSTOTAL_ENABLED=true
# MAILTRACE_DNS_ENABLED=true

# Optional: Override data directory
# MAILTRACE_GENERAL_DATA_DIR=~/.local/share/mailtrace

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# MAILTRACE_GENERAL_LOG_LEVEL=INFO

# Optional: Theme (dark, light, system)
# MAILTRACE_GENERAL_THEME=dark

# Scans are blocked until at least one key-requiring provider is configured.
# Set this to false only if you deliberately want keyless DNS/emailrep runs.
# MAILTRACE_GENERAL_REQUIRE_KEYS=true

# Development only: read the project-local .env as well. The per-user file
# still takes precedence, and this must stay unset for normal use.
# MAILTRACE_USE_PROJECT_ENV=1